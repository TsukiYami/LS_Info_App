<Page
    x:Class="FrontendInfoApp.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FrontendInfoApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainPage"
    d:DesignHeight="550"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Page.Resources>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Visibility" Value="Hidden" />
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#AAAAAA" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

    </Page.Resources>

    <Grid x:Name="MainGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*" />
            <ColumnDefinition Width="100*" />
            <ColumnDefinition Width="100*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>

        <!--  Aktuelles Wetter  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Grid.ColumnSpan="1"
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="#3F3F46" />
            </Border.Background>

            <!--  Layout  -->
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>



                <!--  Stadt, Land  -->
                <StackPanel Grid.Row="0" Orientation="Vertical">
                    <TextBlock
                        x:Name="City"
                        Margin="0,0,0,2"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        FontSize="18"
                        Foreground="White"
                        TextWrapping="Wrap" />

                    <TextBlock
                        x:Name="Country"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        FontSize="12"
                        Foreground="White"
                        Opacity="0.9"
                        TextWrapping="Wrap" />
                </StackPanel>




                <!--  Temperatur  -->
                <Viewbox
                    Grid.Row="2"
                    Margin="0,8,0,8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                    <TextBlock
                        x:Name="Temperature"
                        Background="Transparent"
                        FontSize="60"
                        Foreground="White"
                        Text="" />
                </Viewbox>







                <!--  Condition, FeelsLike  -->
                <StackPanel
                    Grid.Row="3"
                    Margin="0,6,0,0"
                    VerticalAlignment="Bottom"
                    Orientation="Vertical">

                    <TextBlock
                        FontSize="13"
                        Foreground="White"
                        Opacity="0.8"
                        Text="Condition:" />

                    <TextBlock
                        x:Name="ConditionWeather"
                        Margin="0,0,0,4"
                        Background="Transparent"
                        FontSize="18"
                        Foreground="White"
                        Text=""
                        TextWrapping="Wrap" />

                    <TextBlock
                        FontSize="13"
                        Foreground="White"
                        Opacity="0.8"
                        Text="Feels like: " />

                    <TextBlock
                        x:Name="FeelsLike"
                        Background="Transparent"
                        FontSize="18"
                        Foreground="White"
                        Opacity="0.95"
                        TextWrapping="Wrap" />
                </StackPanel>



            </Grid>
        </Border>

        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"           
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">


            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="#3F3F46" />
            </Border.Background>

            <!--  Layout  -->
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>

                <Image
                    x:Name="WeatherIcon"
                    Width="200"
                    Height="200"                  
                    Stretch="UniformToFill"
                     />
            </Grid>
        </Border>

        <!--  Wind  -->
        <Border
            Grid.Row="3"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="#3F3F46" />
            </Border.Background>

            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Margin="0,6,0,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">

                    <TextBlock
                        FontSize="15"
                        Foreground="White"
                        Opacity="0.8"
                        Text="Wind Speed:" />

                    <TextBlock
                        x:Name="WindSpeed"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Background="Transparent"
                        FontSize="40"
                        Foreground="White"
                        Text="Test" />

                </StackPanel>

                <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Margin="0,6,0,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">

                    <TextBlock
                        FontSize="15"
                        Foreground="White"
                        Opacity="0.8"
                        Text="Wind Directory:" />

                    <TextBlock
                        x:Name="WindDirectory"
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Background="Transparent"
                        FontSize="40"
                        Foreground="White"
                        Text="Test" />

                </StackPanel>


            </Grid>
        </Border>

        <!--  Forecast  -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="5"
            Grid.Column="2"
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="#3F3F46" />
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>

                <ListBox
                    x:Name="WeatherForecastList"
                    Grid.RowSpan="3"
                    Grid.ColumnSpan="2"
                    Margin="2"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontSize="15"
                    Foreground="White"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>


    </Grid>
</Page>