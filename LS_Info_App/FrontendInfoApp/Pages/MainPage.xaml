<Page
    x:Class="FrontendInfoApp.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FrontendInfoApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid x:Name="MainGrid">
       

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100*" />
            <ColumnDefinition Width="100*" />
            <ColumnDefinition Width="100*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>



        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="White" />
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>


                <TextBlock
                    x:Name="City"
                    Margin="6"
                    Background="Transparent"
                    FontSize="18"
                    Foreground="White" 
                    Grid.Row="0"
                    VerticalAlignment="Top"/>
                <TextBlock
                    x:Name="Country"
                    Margin="6"                  
                    Background="Transparent"
                    FontSize="10"
                    Foreground="White" 
                    Grid.Row="0"
                    VerticalAlignment="Bottom"/>

                <TextBlock
                    x:Name="Temperature"
                    Grid.Row="1"
                    Grid.RowSpan="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="1"
                    Margin="6"
                    Background="Transparent"
                    FontSize="40"
                    Foreground="White"
                    Text="" />
                <TextBlock
                    x:Name="ConditionWeather"
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="6"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    FontSize="18"
                    Foreground="White"
                    Text="" />

                <TextBlock
                    x:Name="FeelsLike"
                    Grid.Row="2"
                    Margin="6"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    FontSize="14"
                    Foreground="White" />

                <Image
                    x:Name="IconWeather"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Width="100"
                    Height="100"
                    Margin="6" />

            </Grid>
        </Border>



        <Border
            Grid.Row="3"
            Grid.RowSpan="2"
            Grid.Column="0"
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="White" />
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="WindSpeed"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="6"
                    Background="Transparent"
                    FontSize="30"
                    Foreground="White"
                    Text="Test" />
                <TextBlock
                    x:Name="WindDirectory"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="6"
                    Background="Transparent"
                    FontSize="30"
                    Foreground="White"
                    Text="Test" />


            </Grid>
        </Border>

        <Border
            Grid.Row="0"
            Grid.RowSpan="5"
            Grid.Column="1"
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="White" />
            </Border.Background>


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>


                <ListBox
                    x:Name="WeatherForecastList"
                    Grid.RowSpan="3"
                    Grid.ColumnSpan="2"
                    Margin="6"
                    Background="Transparent"
                    FontSize="11"
                    Foreground="White" />

            </Grid>
        </Border>

        <Border
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="White" />
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="6"
                    Background="Transparent"
                    FontSize="30"
                    Foreground="White"
                    Text="Test" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="6"
                    Background="Transparent"
                    FontSize="30"
                    Foreground="White"
                    Text="Test" />


            </Grid>
        </Border>


        <Border
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.Column="2"
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="White" />
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="6"
                    Background="Transparent"
                    FontSize="30"
                    Foreground="White"
                    Text="Test" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="6"
                    Background="Transparent"
                    FontSize="30"
                    Foreground="White"
                    Text="Test" />

            </Grid>

        </Border>


        <Border
            Grid.Row="4"
            Grid.Column="2"
            Margin="6"
            BorderBrush="White"
            CornerRadius="7">

            <Border.Background>
                <SolidColorBrush Opacity="0.6" Color="White" />
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100*" />
                    <RowDefinition Height="100*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="6"
                    Background="Transparent"
                    FontSize="30"
                    Foreground="White"
                    Text="Test" />

            </Grid>

        </Border>

    </Grid>
</Page>